name: Generate SBOM with Syft

on:
  push:
    branches: [ "master" ]
  pull_request:
    branches: [ "master" ]
  workflow_dispatch:          # allow manual runs from the Actions tab

permissions:
  contents: read

jobs:
  generate-sbom:
    name: Generate SBOM
    runs-on: ubuntu-latest

    steps:
      # 1. Get the source code
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Install Syft CLI
      - name: Install Syft
        run: |
          curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin
          syft version

      # 3. Generate SBOMs in JSON formats
      - name: Generate SBOM (CycloneDX JSON)
        run: syft dir:. -o cyclonedx-json=sbom.cyclonedx.json

      - name: Generate SBOM (SPDX JSON)
        run: syft dir:. -o spdx-json=sbom.spdx.json

      # ---------------------------------------------------------------
      # OPTIONAL: generate an SBOM for a Docker image instead.
      # - name: Build Docker image
      #   run: docker build -t myapp:${{ github.sha }} .
      # - name: Generate image SBOM
      #   run: syft myapp:${{ github.sha }} -o cyclonedx-json=image-sbom.cyclonedx.json
      # ---------------------------------------------------------------

      # 4. Show a quick summary of what was found
      - name: SBOM summary
        run: |
          count=$(jq '.components | length' sbom.cyclonedx.json)
          echo "## SBOM Generated" >> $GITHUB_STEP_SUMMARY
          echo "Total components found: **$count**" >> $GITHUB_STEP_SUMMARY

      # 5. Upload SBOM files as downloadable artifacts
      - name: Upload SBOM artifacts
        uses: actions/upload-artifact@v4
        with:
          name: sbom-files
          path: |
            sbom.cyclonedx.json
            sbom.spdx.json
          retention-days: 30
